# Copy this file to `.env` and fill in values only for the live features you want
# to exercise. Both assignments run fully offline with NONE of these set.
# Never commit real secrets. We do not need your keys.

# --- Assignment A: optional LLM understanding + phrasing (OpenAI Responses API) ---
# Standard OpenAI:
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5-mini
# Optional: point at an OpenAI-compatible endpoint (e.g. Azure OpenAI v1).
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
# Azure alternatives (used only if OPENAI_* above are not set):
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# --- Assignment B: optional AI image generation ---
# Default: OpenAI-compatible Images API (reuses OPENAI_API_KEY / OPENAI_BASE_URL,
# or the AZURE_OPENAI_* values above; a bare *.openai.azure.com host automatically
# gets /openai/v1 appended). Model defaults to FLUX.2-pro.
# For a Foundry provider model (e.g. FLUX on Azure AI Foundry) whose route differs
# from /images/generations, set the FULL image URL explicitly. The request body
# then uses width/height instead of size.
# OPENAI_IMAGE_URL=https://<resource>.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-pro?api-version=preview
OPENAI_IMAGE_MODEL=FLUX.2-pro

# --- Assignment B: optional Ravelry reference lookup ---
RAVELRY_USERNAME=your-ravelry-api-username
RAVELRY_ACCESS_KEY=your-ravelry-api-access-key
